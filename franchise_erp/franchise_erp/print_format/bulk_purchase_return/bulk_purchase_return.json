 "doc_type": "Bulk Purchase Return",
 "docstatus": 0,
 "doctype": "Print Format",
 "font_size": 14,
 "html": "<style>\n    /* ===== RESET & GLOBAL STYLES ===== */\n    * {\n        margin: 0;\n        padding: 0;\n        box-sizing: border-box;\n        font-family: Arial, Helvetica, sans-serif !important;\n    }\n\n    body {\n        background: #fff;\n    }\n\n    @page {\n        size: A4;\n        margin: 0.2in;\n    }\n\n    .print-format {\n        width: 100%;\n        max-width: 21cm;\n        margin: 0 auto;\n    }\n\n    /* ===== MAIN BORDER ===== */\n    .main-container {\n        border: 1px solid #000;\n        background: #fff;\n    }\n\n    /* ===== TYPOGRAPHY ===== */\n    .fs-small {\n        font-size: 11px !important;\n    }\n\n    .fs-mini {\n        font-size: 10px !important;\n    }\n\n    .fs-xsmall {\n        font-size: 9px !important;\n    }\n\n    .fw-bold {\n        font-weight: bold !important;\n    }\n\n    .fw-bolder {\n        font-weight: bolder !important;\n    }\n\n    .text-center {\n        text-align: center !important;\n    }\n\n    .text-right {\n        text-align: right !important;\n    }\n\n    .fst-upper {\n        text-transform: uppercase !important;\n    }\n\n    /* ===== TABLES ===== */\n    table {\n        width: 100%;\n        border-collapse: collapse;\n        table-layout: fixed;\n    }\n\n    th,\n    td {\n        border: 1px solid #000;\n        padding: 4px 6px;\n        vertical-align: top;\n        word-wrap: break-word;\n    }\n\n    .no-border,\n    .no-border td {\n        border: none !important;\n    }\n\n    .doc-title {\n        border-bottom: 1px solid #000;\n        text-align: center;\n        font-weight: bold;\n        font-size: 16px;\n        padding: 3px 0;\n        background-color: #f9f9f9;\n    }\n</style>\n\n\n<!-- ========================================================= -->\n<!-- COMPANY DETAILS - BILL TO -->\n<!-- ========================================================= -->\n\n{% set bill_company = frappe.get_doc(\"Company\", doc.company) %}\n\n\n<!-- ========================================================= -->\n<!-- SUPPLIER -> CUSTOM COMPANY -> SHIP TO COMPANY -->\n<!-- ========================================================= -->\n\n{% set supplier_doc = frappe.get_doc(\"Supplier\", doc.supplier) if doc.supplier else None %}\n\n{% set ship_company_name = supplier_doc.custom_company if supplier_doc and supplier_doc.custom_company else None %}\n\n{% set ship_company = frappe.get_doc(\"Company\", ship_company_name) if ship_company_name else None %}\n\n\n<div class=\"print-format\">\n\n    <div class=\"main-container\">\n\n        <!-- ===================================================== -->\n        <!-- TITLE -->\n        <!-- ===================================================== -->\n\n        <div class=\"doc-title\">\n            Bulk Purchase Return\n        </div>\n\n\n        <!-- ===================================================== -->\n        <!-- INFO SECTION -->\n        <!-- ===================================================== -->\n\n        <table style=\"border-bottom: 1px solid #000;\">\n\n            <tr>\n\n                <!-- ================================================= -->\n                <!-- LEFT SIDE : BILL TO -->\n                <!-- ================================================= -->\n\n                <td style=\"width: 55%; border-top: none; border-left: none;\">\n\n                    <table class=\"no-border fs-mini\">\n\n                        <tr>\n\n                            <td style=\"width: 60px;\">\n                                <p class=\"fs-small fw-bold\">\n                                    Bill To:\n                                </p>\n                            </td>\n\n                            <td>\n\n                                <!-- Company Name -->\n\n                                <p class=\"fs-small fw-bold m-0\">\n                                    {{ bill_company.company_name or bill_company.name }}\n                                </p>\n\n\n                                <!-- Company Address -->\n\n                                <p class=\"fs-small\" style=\"color: #333;\">\n\n                                    {% if bill_company.address %}\n                                        {{ bill_company.address }}\n                                    {% else %}\n\n                                        {% set company_address = frappe.get_all(\n                                            \"Dynamic Link\",\n                                            filters={\n                                                \"link_doctype\": \"Company\",\n                                                \"link_name\": bill_company.name,\n                                                \"parenttype\": \"Address\"\n                                            },\n                                            fields=[\"parent\"],\n                                            limit=1\n                                        ) %}\n\n                                        {% if company_address %}\n\n                                            {% set b_addr = frappe.get_doc(\n                                                \"Address\",\n                                                company_address[0].parent\n                                            ) %}\n\n                                            {{ b_addr.address_line1 or '' }}\n\n                                            {% if b_addr.address_line2 %}\n                                                , {{ b_addr.address_line2 }}\n                                            {% endif %}\n\n                                            {% if b_addr.city %}\n                                                , {{ b_addr.city }}\n                                            {% endif %}\n\n                                            {% if b_addr.state %}\n                                                , {{ b_addr.state }}\n                                            {% endif %}\n\n                                            {% if b_addr.pincode %}\n                                                - {{ b_addr.pincode }}\n                                            {% endif %}\n\n                                        {% endif %}\n\n                                    {% endif %}\n\n                                </p>\n\n\n                                <!-- GSTIN -->\n\n                                <p class=\"fs-small fw-bold\" style=\"margin-top: 2px;\">\n\n                                    GSTIN:\n                                    {{ bill_company.gstin or '-' }}\n\n                                </p>\n\n                            </td>\n\n                        </tr>\n\n\n                        <!-- ================================================= -->\n                        <!-- SHIP TO -->\n                        <!-- ================================================= -->\n\n                        <tr>\n\n                            <td style=\"padding-top: 10px;\">\n\n                                <p class=\"fs-small fw-bold\">\n                                    Ship To:\n                                </p>\n\n                            </td>\n\n                            <td style=\"padding-top: 10px;\">\n\n                                {% if ship_company %}\n\n                                    <!-- Ship To Company -->\n\n                                    <p class=\"fs-small fw-bold m-0\">\n\n                                        {{ ship_company.company_name or ship_company.name }}\n\n                                    </p>\n\n\n                                    <!-- Ship To Address -->\n\n                                    <p class=\"fs-small\" style=\"color: #333;\">\n\n                                        {% set ship_addresses = frappe.get_all(\n                                            \"Dynamic Link\",\n                                            filters={\n                                                \"link_doctype\": \"Company\",\n                                                \"link_name\": ship_company.name,\n                                                \"parenttype\": \"Address\"\n                                            },\n                                            fields=[\"parent\"],\n                                            limit=1\n                                        ) %}\n\n\n                                        {% if ship_addresses %}\n\n                                            {% set s_addr = frappe.get_doc(\n                                                \"Address\",\n                                                ship_addresses[0].parent\n                                            ) %}\n\n\n                                            {{ s_addr.address_line1 or '' }}\n\n                                            {% if s_addr.address_line2 %}\n                                                , {{ s_addr.address_line2 }}\n                                            {% endif %}\n\n                                            {% if s_addr.city %}\n                                                , {{ s_addr.city }}\n                                            {% endif %}\n\n                                            {% if s_addr.state %}\n                                                , {{ s_addr.state }}\n                                            {% endif %}\n\n                                            {% if s_addr.pincode %}\n                                                - {{ s_addr.pincode }}\n                                            {% endif %}\n\n                                        {% endif %}\n\n                                    </p>\n\n\n                                    <!-- Ship To GSTIN -->\n\n                                    <p class=\"fs-small fw-bold\" style=\"margin-top: 2px;\">\n\n                                        GSTIN:\n                                        {{ ship_company.gstin or '-' }}\n\n                                    </p>\n\n                                {% else %}\n\n                                    <p class=\"fs-small\">\n                                        -\n                                    </p>\n\n                                {% endif %}\n\n                            </td>\n\n                        </tr>\n\n                    </table>\n\n                </td>\n\n\n                <!-- ================================================= -->\n                <!-- RIGHT SIDE : RETURN INFORMATION -->\n                <!-- ================================================= -->\n\n                <td style=\"width: 45%; border-top: none; border-right: none;\">\n\n                    <table class=\"no-border fs-mini\">\n\n                        <!-- Supplier -->\n\n                        <tr>\n\n                            <td class=\"fw-bold\"\n                                style=\"width: 130px; padding: 2px 0;\">\n\n                                Supplier:\n\n                            </td>\n\n                            <td>\n\n                                {{ doc.supplier or '-' }}\n\n                            </td>\n\n                        </tr>\n\n\n                        <!-- Invoice No -->\n\n                        <tr>\n\n                            <td class=\"fw-bold\"\n                                style=\"padding: 2px 0;\">\n\n                                Invoice No:\n\n                            </td>\n\n                            <td>\n\n                                {{ doc.name }}\n\n                            </td>\n\n                        </tr>\n\n\n                        <!-- Posting Date -->\n\n                        <tr>\n\n                            <td class=\"fw-bold\"\n                                style=\"padding: 2px 0;\">\n\n                                Posting Date:\n\n                            </td>\n\n                            <td>\n\n                                {{ doc.get_formatted(\"posting_date\") }}\n\n                            </td>\n\n                        </tr>\n\n\n                        <!-- Company -->\n\n                        <tr>\n\n                            <td class=\"fw-bold\"\n                                style=\"padding: 2px 0;\">\n\n                                Company:\n\n                            </td>\n\n                            <td>\n\n                                {{ doc.company or '-' }}\n\n                            </td>\n\n                        </tr>\n\n\n                        <!-- Return Creation Status -->\n\n                        <tr>\n\n                            <td class=\"fw-bold\"\n                                style=\"padding: 2px 0;\">\n\n                                Return Creation Status:\n\n                            </td>\n\n                            <td>\n\n                                {{ doc.status or '-' }}\n\n                            </td>\n\n                        </tr>\n\n\n                        <!-- Return Submission Status -->\n\n                        <tr>\n\n                            <td class=\"fw-bold\"\n                                style=\"padding: 2px 0;\">\n\n                                Return Submission Status:\n\n                            </td>\n\n                            <td>\n\n                                {{ doc.submit_status or '-' }}\n\n                            </td>\n\n                        </tr>\n\n                    </table>\n\n                </td>\n\n            </tr>\n\n        </table>\n\n\n        <!-- ===================================================== -->\n        <!-- ITEMS TABLE -->\n        <!-- ===================================================== -->\n\n       <table style=\"\n    table-layout: fixed;\n    width: 100%;\n    border-collapse: collapse;\n    border-top: none;\n\">\n\n    <thead style=\"display: table-header-group;\">\n\n        <tr style=\"\n            background-color: #fafafa;\n            page-break-inside: avoid;\n        \">\n\n            <th style=\"\n                width: 6%;\n                border-left: 0px;\n                border-top: 0px;\n                padding: 4px 2px;\n            \"\n            class=\"text-center fs-xsmall fw-bold\">\n                S.N.\n            </th>\n\n            <th style=\"\n                width: 30%;\n                border-top: 0px;\n                padding: 4px 2px;\n            \"\n            class=\"fs-xsmall fw-bold\">\n                Product Description\n            </th>\n\n            <th style=\"\n                width: 14%;\n                border-top: 0px;\n                padding: 4px 2px;\n            \"\n            class=\"text-center fs-xsmall fw-bold\">\n                HSN\n            </th>\n\n            <th style=\"\n                width: 15%;\n                border-top: 0px;\n                padding: 4px 2px;\n            \"\n            class=\"text-right fs-xsmall fw-bold\">\n                Rate\n            </th>\n\n            <th style=\"\n                width: 15%;\n                border-top: 0px;\n                padding: 4px 2px;\n            \"\n            class=\"text-center fs-xsmall fw-bold\">\n                Qty\n            </th>\n\n            <th style=\"\n                width: 20%;\n                border-top: 0px;\n                border-right: 0px;\n                padding: 4px 2px;\n            \"\n            class=\"text-right fs-xsmall fw-bold\">\n                Amount\n            </th>\n\n        </tr>\n\n    </thead>\n\n\n    <tbody style=\"display: table-row-group;\">\n\n        <!-- ================================================= -->\n        <!-- GROUP ITEMS -->\n        <!-- ================================================= -->\n\n        {% set grouped_items = {} %}\n\n        {% for item in doc.items %}\n\n            <!-- Product Description -->\n\n            {% set style = frappe.db.get_value(\n                \"Item\",\n                item.item_code,\n                \"custom_barcode_code\"\n            ) or item.item_name or item.item_code %}\n\n\n            <!-- HSN FETCH FROM ITEM MASTER -->\n\n            {% set item_hsn = frappe.db.get_value(\n                \"Item\",\n                item.item_code,\n                \"gst_hsn_code\"\n            ) or \"-\" %}\n\n\n            <!-- RATE -->\n\n            {% set item_rate = item.rate or 0 %}\n\n\n            <!-- QTY -->\n\n            {% set item_qty = item.qty or 0 %}\n\n\n            <!-- AMOUNT = RATE * QTY -->\n\n            {% set item_amount = item_rate * item_qty %}\n\n\n            {% if style not in grouped_items %}\n\n                {% set _ = grouped_items.update({\n                    style: {\n                        \"item_code\": item.item_code,\n                        \"item_name\": item.item_name,\n                        \"hsn\": item_hsn,\n                        \"rate\": item_rate,\n                        \"qty\": item_qty,\n                        \"amount\": item_amount\n                    }\n                }) %}\n\n            {% else %}\n\n                {% set existing = grouped_items[style] %}\n\n                {% set _ = existing.update({\n\n                    \"qty\":\n                        (existing.qty or 0) + item_qty,\n\n                    \"amount\":\n                        (existing.amount or 0) + item_amount\n\n                }) %}\n\n            {% endif %}\n\n        {% endfor %}\n\n\n        <!-- ================================================= -->\n        <!-- TOTALS INITIALIZATION -->\n        <!-- ================================================= -->\n\n        {% set table_totals = {\n            \"qty\": 0,\n            \"amount\": 0\n        } %}\n\n\n        <!-- ================================================= -->\n        <!-- ITEM ROWS -->\n        <!-- ================================================= -->\n\n        {% for style, data in grouped_items.items() %}\n\n            <tr style=\"page-break-inside: avoid !important;\">\n\n                <!-- S.N. -->\n\n                <td class=\"text-center fs-mini\"\n                    style=\"border-left: 0px !important;\">\n\n                    {{ loop.index }}\n\n                </td>\n\n\n                <!-- PRODUCT DESCRIPTION -->\n\n                <td class=\"fs-mini\">\n\n                    {{ style }}\n\n                </td>\n\n\n                <!-- HSN -->\n\n                <td class=\"text-center fs-mini\">\n\n                    {{ data.hsn or \"-\" }}\n\n                </td>\n\n\n                <!-- RATE -->\n\n                <td class=\"text-right fs-mini\">\n\n                    -{{ frappe.utils.fmt_money(\n                        data.rate,\n                        currency=doc.currency\n                    ) }}\n\n                </td>\n\n\n                <!-- QTY -->\n\n                <td class=\"text-center fs-mini\">\n\n                    -{{ data.qty }}\n\n                </td>\n\n\n                <!-- AMOUNT = RATE * QTY -->\n\n                <td class=\"text-right fs-mini\"\n                    style=\"border-right: 0px !important;\">\n\n                    -{{ frappe.utils.fmt_money(\n                        data.amount,\n                        currency=doc.currency\n                    ) }}\n\n                </td>\n\n            </tr>\n\n\n            <!-- UPDATE TOTALS -->\n\n            {% set _ = table_totals.update({\n\n                \"qty\":\n                    table_totals.qty + (data.qty or 0),\n\n                \"amount\":\n                    table_totals.amount + (data.amount or 0)\n\n            }) %}\n\n        {% endfor %}\n\n\n        <!-- ================================================= -->\n        <!-- GRAND TOTAL -->\n        <!-- ================================================= -->\n\n        <tr style=\"\n            font-weight: bold;\n            background-color: #fafafa;\n        \">\n\n            <td colspan=\"4\"\n                class=\"text-right\"\n                style=\"\n                    padding: 4px 15px;\n                    border-left: 0px !important;\n                \">\n\n                Total\n\n            </td>\n\n\n            <td class=\"text-center\">\n\n                -{{ table_totals.qty }}\n\n            </td>\n\n\n            <td class=\"text-right\"\n                style=\"\n                    border-right: 0px !important;\n                \">\n\n                -{{ frappe.utils.fmt_money(\n                    table_totals.amount,\n                    currency=doc.currency\n                ) }}\n\n            </td>\n\n        </tr>\n\n    </tbody>\n\n</table>\n\n    </div>\n\n</div>",
