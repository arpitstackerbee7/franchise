 "css": "/* =========================================================\n   SALARY SLIP\n   ========================================================= */\n\n.salary-slip {\n    width: 100%;\n\n    font-family: Arial, Helvetica, sans-serif;\n\n    font-size: 10px;\n\n    color: #222;\n\n    margin: 0;\n\n    padding: 0;\n}\n\n\n/* =========================================================\n   MAIN CONTAINER\n   ========================================================= */\n\n.print-container {\n    width: 100%;\n\n    max-width: 700px;\n\n    margin: 20px auto;\n\n    border: 1px solid #222;\n\n    box-sizing: border-box;\n\n    background: #fff;\n}\n\n\n/* =========================================================\n   COMPANY HEADER\n   ========================================================= */\n\n.company-header {\n    width: 100%;\n\n    box-sizing: border-box;\n\n    border-bottom: 1px solid #222;\n\n    padding: 10px 14px;\n\n    position: relative;\n\n    min-height: 90px;\n\n    overflow: hidden;\n}\n\n\n/* =========================================================\n   COMPANY DETAILS\n   CENTERED\n   ========================================================= */\n\n.company-details-cell {\n    width: 100%;\n\n    box-sizing: border-box;\n\n    padding: 0;\n\n    margin: 0;\n\n    text-align: center;\n\n    vertical-align: middle;\n}\n\n\n/* =========================================================\n   COMPANY NAME\n   ========================================================= */\n\n.company-name {\n    font-size: 14px;\n\n    font-weight: 700;\n\n    color: #222;\n\n    margin: 0 0 4px 0;\n\n    padding: 0;\n\n    text-align: center;\n\n    text-transform: uppercase;\n\n    line-height: 1.2;\n}\n\n\n/* =========================================================\n   COMPANY DETAIL ROW\n   ========================================================= */\n\n.company-detail-row {\n    font-size: 9px;\n\n    line-height: 1.4;\n\n    color: #222;\n\n    margin: 0;\n\n    padding: 0;\n\n    text-align: center;\n}\n\n\n/* =========================================================\n   COMPANY DETAIL LABEL\n   ========================================================= */\n\n.company-detail-label {\n    font-weight: 700;\n\n    margin-right: 4px;\n}\n\n\n/* =========================================================\n   COMPANY CONTACT\n   ========================================================= */\n\n.company-contact {\n    font-size: 9px;\n\n    color: #333;\n\n    margin-top: 4px;\n\n    padding: 0;\n\n    text-align: center;\n\n    line-height: 1.3;\n}\n\n\n.company-contact span {\n    margin-right: 12px;\n}\n\n\n/* =========================================================\n   LOGO CELL\n   EXTREME RIGHT\n   ========================================================= */\n\n.company-logo-cell {\n    position: absolute;\n\n    top: 10px;\n\n    right: 14px;\n\n    width: 90px;\n\n    height: 70px;\n\n    padding: 0;\n\n    margin: 0;\n\n    text-align: right;\n\n    vertical-align: middle;\n\n    box-sizing: border-box;\n}\n\n\n/* =========================================================\n   COMPANY LOGO\n   ========================================================= */\n\n.company-logo {\n    width: 90px;\n\n    height: 70px;\n\n    object-fit: contain;\n\n    display: block;\n\n    margin: 0;\n\n    padding: 0;\n}\n\n\n/* =========================================================\n   DOCUMENT TITLE\n   ========================================================= */\n\n.document-title {\n    width: 100%;\n\n    text-align: center;\n\n    padding: 5px 0;\n\n    border-bottom: 1px solid #222;\n\n    box-sizing: border-box;\n}\n\n\n/* =========================================================\n   SALARY SLIP TITLE\n   ========================================================= */\n\n.salary-slip-title {\n    font-size: 11px;\n\n    font-weight: 700;\n\n    color: #111;\n\n    line-height: 1.2;\n\n    text-align: center;\n}\n\n\n/* =========================================================\n   SLIP NUMBER\n   ========================================================= */\n\n.slip-number {\n    margin-top: 2px;\n\n    font-size: 10px;\n\n    font-weight: 700;\n\n    color: #222;\n}\n\n\n/* =========================================================\n   SECTION HEADING\n   ========================================================= */\n\n.section-heading {\n    width: 100%;\n\n    box-sizing: border-box;\n\n    background: #f3f3f3;\n\n    border-bottom: 1px solid #c9c9c9;\n\n    padding: 6px 8px;\n\n    font-size: 10px;\n\n    font-weight: 700;\n\n    color: #222;\n}\n\n\n/* =========================================================\n   SALARY HEADING\n   ========================================================= */\n\n.salary-heading {\n    border-top: 1px solid #222;\n\n    margin-top: 0;\n}\n\n\n/* =========================================================\n   EMPLOYEE INFORMATION\n   ========================================================= */\n\n.employee-info {\n    width: 100%;\n\n    box-sizing: border-box;\n}\n\n\n/* =========================================================\n   EMPLOYEE ROW\n   ========================================================= */\n\n.employee-row {\n    width: 100%;\n\n    min-height: 26px;\n\n    display: grid;\n\n    grid-template-columns: 18% 32% 18% 32%;\n\n    align-items: center;\n\n    box-sizing: border-box;\n\n    border-bottom: 1px solid #dedede;\n}\n\n\n/* =========================================================\n   EMPLOYEE LABEL\n   ========================================================= */\n\n.employee-label {\n    box-sizing: border-box;\n\n    padding: 5px 7px;\n\n    font-size: 9px;\n\n    line-height: 1.2;\n\n    font-weight: 700;\n\n    color: #222;\n\n    text-align: left;\n\n    white-space: nowrap;\n}\n\n\n/* =========================================================\n   EMPLOYEE VALUE\n   ========================================================= */\n\n.employee-value {\n    box-sizing: border-box;\n\n    padding: 5px 7px;\n\n    font-size: 9px;\n\n    line-height: 1.2;\n\n    font-weight: 400;\n\n    color: #333;\n\n    text-align: left;\n\n    white-space: nowrap;\n}\n\n\n/* =========================================================\n   SALARY TABLES\n   ========================================================= */\n\n.salary-tables {\n    width: 100%;\n\n    display: flex;\n\n    gap: 0;\n\n    align-items: stretch;\n\n    box-sizing: border-box;\n}\n\n\n/* =========================================================\n   SALARY COLUMN\n   ========================================================= */\n\n.salary-column {\n    width: 50%;\n\n    box-sizing: border-box;\n}\n\n\n/* =========================================================\n   SALARY TABLE\n   ========================================================= */\n\n.salary-table {\n    width: 100%;\n\n    border-collapse: collapse;\n\n    table-layout: fixed;\n\n    font-size: 9px;\n\n    color: #222;\n}\n\n\n/* =========================================================\n   SALARY TABLE HEADER\n   ========================================================= */\n\n.salary-table th {\n    background: #f3f3f3;\n\n    border: 1px solid #c9c9c9;\n\n    padding: 5px 6px;\n\n    font-size: 9px;\n\n    font-weight: 700;\n\n    color: #222;\n\n    text-align: left;\n\n    vertical-align: middle;\n}\n\n\n/* =========================================================\n   SALARY TABLE BODY\n   ========================================================= */\n\n.salary-table td {\n    border: 1px solid #c9c9c9;\n\n    padding: 5px 6px;\n\n    font-size: 9px;\n\n    font-weight: 400;\n\n    color: #222;\n\n    line-height: 1.2;\n\n    vertical-align: middle;\n}\n\n\n/* =========================================================\n   COMPONENT\n   ========================================================= */\n\n.salary-table .component {\n    font-size: 9px;\n\n    font-weight: 400;\n\n    color: #222;\n\n    overflow-wrap: break-word;\n}\n\n\n/* =========================================================\n   SERIAL NUMBER\n   ========================================================= */\n\n.salary-table .sr {\n    width: 28px;\n\n    text-align: center;\n\n    font-size: 9px;\n\n    font-weight: 400;\n\n    color: #222;\n}\n\n\n/* =========================================================\n   AMOUNT\n   ========================================================= */\n\n.salary-table .amount {\n    width: 90px;\n\n    text-align: right;\n\n    white-space: nowrap;\n\n    font-size: 9px;\n\n    font-weight: 400;\n\n    color: #222;\n}\n\n\n/* =========================================================\n   TOTAL ROW\n   ========================================================= */\n\n.salary-table .total-row td {\n    background: #fafafa;\n\n    font-size: 9px;\n\n    font-weight: 700;\n\n    color: #222;\n}\n\n\n.salary-table .total-row .amount {\n    font-weight: 700;\n}\n\n\n/* =========================================================\n   PAYMENT SUMMARY\n   ========================================================= */\n\n.summary {\n    width: 100%;\n\n    margin-top: 0;\n\n    padding: 8px 0 0 0;\n\n    border-top: 1px solid #222;\n\n    box-sizing: border-box;\n}\n\n\n/* =========================================================\n   SUMMARY TABLE\n   ========================================================= */\n\n.summary-table {\n    width: 100%;\n\n    border-collapse: collapse;\n}\n\n\n/* =========================================================\n   SUMMARY TABLE CELLS\n   ========================================================= */\n\n.summary-table td {\n    padding: 4px 8px;\n\n    font-size: 9px;\n\n    color: #222;\n}\n\n\n/* =========================================================\n   SUMMARY LABEL\n   ========================================================= */\n\n.summary-label {\n    width: 78%;\n\n    text-align: right;\n\n    font-weight: 700;\n}\n\n\n/* =========================================================\n   SUMMARY AMOUNT\n   ========================================================= */\n\n.summary-amount {\n    width: 22%;\n\n    text-align: right;\n\n    font-weight: 700;\n\n    white-space: nowrap;\n}\n\n\n/* =========================================================\n   NET PAY\n   ========================================================= */\n\n.net-pay-row td {\n    border-top: 1px solid #999;\n\n    border-bottom: 1px solid #999;\n\n    padding-top: 6px;\n\n    padding-bottom: 6px;\n}\n\n\n.net-pay-row .summary-label,\n.net-pay-row .summary-amount {\n    font-size: 10px;\n\n    font-weight: 700;\n}\n\n\n/* =========================================================\n   AMOUNT IN WORDS\n   ========================================================= */\n\n.in-words {\n    width: 100%;\n\n    box-sizing: border-box;\n\n    margin-top: 8px;\n\n    padding: 6px 8px;\n\n    border-top: 1px solid #c9c9c9;\n\n    font-size: 8px;\n\n    line-height: 1.4;\n\n    color: #333;\n}\n\n\n/* =========================================================\n   WORDS LABEL\n   ========================================================= */\n\n.words-label {\n    font-weight: 700;\n\n    color: #222;\n}\n\n\n/* =========================================================\n   FOOTER\n   ========================================================= */\n\n.footer {\n    width: 100%;\n\n    box-sizing: border-box;\n\n    margin-top: 8px;\n\n    padding: 6px 8px;\n\n    border-top: 1px solid #d0d0d0;\n\n    text-align: center;\n\n    font-size: 7px;\n\n    color: #777;\n}\n\n\n/* =========================================================\n   PRINT\n   ========================================================= */\n\n@media print {\n\n    .salary-slip {\n        width: 100%;\n\n        margin: 0;\n\n        padding: 0;\n    }\n\n\n    .print-container {\n        width: 100%;\n\n        max-width: 700px;\n\n        margin: 0 auto;\n\n        border: 1px solid #222;\n\n        page-break-inside: avoid;\n    }\n\n\n    .company-header {\n        page-break-inside: avoid;\n\n        position: relative;\n    }\n\n\n    .document-title {\n        page-break-inside: avoid;\n    }\n\n\n    .employee-info {\n        page-break-inside: avoid;\n    }\n\n\n    .salary-tables {\n        page-break-inside: avoid;\n    }\n\n\n    .summary {\n        page-break-inside: avoid;\n    }\n\n\n    .salary-table {\n        page-break-inside: auto;\n    }\n\n\n    .salary-table tr {\n        page-break-inside: avoid;\n    }\n}",
