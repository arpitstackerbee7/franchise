 "html": "{% set company_doc = frappe.get_doc(\"Company\", doc.company) %}\n\n{% set company_address = \"\" %}\n{% set company_phone = company_doc.phone_no or \"\" %}\n{% set company_email = company_doc.email or \"\" %}\n\n{# =========================================================\n   GET COMPANY ADDRESS (only address, sales invoice ki tarah)\n   ========================================================= #}\n\n{% set address_name = frappe.db.get_value(\n    \"Dynamic Link\",\n    {\n        \"link_doctype\": \"Company\",\n        \"link_name\": doc.company,\n        \"parenttype\": \"Address\"\n    },\n    \"parent\"\n) %}\n\n{% if address_name %}\n\n    {% set address_doc = frappe.get_doc(\"Address\", address_name) %}\n\n    {% if address_doc.address_line1 %}\n        {% set company_address = address_doc.address_line1 %}\n    {% endif %}\n\n    {% if address_doc.address_line2 %}\n        {% set company_address = company_address + \", \" + address_doc.address_line2 %}\n    {% endif %}\n\n    {% if address_doc.city %}\n        {% set company_address = company_address + \", \" + address_doc.city %}\n    {% endif %}\n\n    {% if address_doc.state %}\n        {% set company_address = company_address + \", \" + address_doc.state %}\n    {% endif %}\n\n    {% if address_doc.pincode %}\n        {% set company_address = company_address + \" \" + address_doc.pincode %}\n    {% endif %}\n\n{% endif %}\n<!-- =========================================================\n     SALARY SLIP\n     ========================================================= -->\n\n<div class=\"salary-slip\">\n\n    <div class=\"print-container\">\n\n\n        <div class=\"company-header\">\n\n    <div class=\"company-details-cell\">\n\n        <div class=\"company-name\">\n            {{ doc.company }}\n        </div>\n\n        \n\n        {% if company_address %}\n        <div class=\"company-detail-row\">\n            <span class=\"company-detail-label\">Address:</span>\n            {{ company_address }}\n        </div>\n        {% endif %}\n\n        {% if company_phone or company_email %}\n        <div class=\"company-contact\">\n\n            {% if company_phone %}\n            <span>\u260e {{ company_phone }}</span>\n            {% endif %}\n\n            {% if company_email %}\n            <span>\u2709 {{ company_email }}</span>\n            {% endif %}\n\n        </div>\n        {% endif %}\n\n    </div>\n\n\n    <div class=\"company-logo-cell\">\n\n        {% if company_doc.company_logo %}\n\n        <img\n            src=\"{{ company_doc.company_logo }}\"\n            class=\"company-logo\"\n        >\n\n        {% endif %}\n\n    </div>\n\n</div>\n\n\n        <!-- =====================================================\n             SALARY SLIP TITLE\n             ===================================================== -->\n\n        <div class=\"document-title\">\n\n            <div class=\"salary-slip-title\">\n    Salary Slip for the month of {{ frappe.utils.formatdate(doc.start_date, \"MMMM yyyy\") }}\n</div>\n            \n\n        </div>\n\n\n        <!-- =====================================================\n             EMPLOYEE INFORMATION\n             ===================================================== -->\n\n<div class=\"employee-info\">\n\n    <!-- Employee ID + Working Days -->\n    <div class=\"employee-row\">\n\n        <div class=\"employee-label\">\n            Employee ID\n        </div>\n\n        <div class=\"employee-value\">\n            {{ doc.employee }}\n        </div>\n\n        <div class=\"employee-label\">\n            Working Days\n        </div>\n\n        <div class=\"employee-value\">\n            {{ doc.total_working_days or 0 }}\n        </div>\n\n    </div>\n\n\n    <!-- Employee Name + Payment Days -->\n    <div class=\"employee-row\">\n\n        <div class=\"employee-label\">\n            Employee Name\n        </div>\n\n        <div class=\"employee-value\">\n            {{ doc.employee_name }}\n        </div>\n\n        <div class=\"employee-label\">\n            Payment Days\n        </div>\n\n        <div class=\"employee-value\">\n            {{ doc.payment_days or 0 }}\n        </div>\n\n    </div>\n\n\n    <!-- Department -->\n    <div class=\"employee-row\">\n\n        <div class=\"employee-label\">\n            Department\n        </div>\n\n        <div class=\"employee-value\">\n            {{ doc.department or \"-\" }}\n        </div>\n\n        <div></div>\n        <div></div>\n\n    </div>\n\n\n    <!-- Designation -->\n    <div class=\"employee-row\">\n\n        <div class=\"employee-label\">\n            Designation\n        </div>\n\n        <div class=\"employee-value\">\n            {{ doc.designation or \"-\" }}\n        </div>\n\n        <div></div>\n        <div></div>\n\n    </div>\n\n\n    <!-- Branch -->\n    <div class=\"employee-row\">\n\n        <div class=\"employee-label\">\n            Branch\n        </div>\n\n        <div class=\"employee-value\">\n            {{ doc.branch or \"-\" }}\n        </div>\n\n        <div></div>\n        <div></div>\n\n    </div>\n\n</div>\n\n        <!-- =====================================================\n             SALARY DETAILS\n             ===================================================== -->\n\n        <div class=\"section-heading salary-heading\">\n            Salary Details\n        </div>\n\n\n        <div class=\"salary-tables\">\n\n\n            <!-- =================================================\n                 EARNINGS\n                 ================================================= -->\n\n            <div class=\"salary-column\">\n\n                <table class=\"salary-table\">\n\n                    <thead>\n\n                        <tr>\n\n                            <th class=\"sr\">\n                                Sr.\n                            </th>\n\n                            <th class=\"component\">\n                                Component\n                            </th>\n\n                            <th class=\"amount\">\n                                Amount\n                            </th>\n\n                        </tr>\n\n                    </thead>\n\n\n                    <tbody>\n\n                        {% for row in doc.earnings %}\n\n                        <tr>\n\n                            <td class=\"sr\">\n                                {{ loop.index }}\n                            </td>\n\n                            <td class=\"component\">\n                                {{ row.salary_component }}\n                            </td>\n\n                            <td class=\"amount\">\n                                {{ frappe.utils.fmt_money(\n                                    row.amount,\n                                    currency=doc.currency\n                                ) }}\n                            </td>\n\n                        </tr>\n\n                        {% endfor %}\n\n\n                        <tr class=\"total-row\">\n\n                            <td colspan=\"2\">\n                                Gross Pay\n                            </td>\n\n                            <td class=\"amount\">\n                                {{ frappe.utils.fmt_money(\n    doc.gross_pay | round(0),\n    currency=doc.currency\n) }}\n                            </td>\n\n                        </tr>\n\n                    </tbody>\n\n                </table>\n\n            </div>\n\n\n            <!-- =================================================\n                 DEDUCTIONS\n                 ================================================= -->\n\n            <div class=\"salary-column\">\n\n                <table class=\"salary-table\">\n\n                    <thead>\n\n                        <tr>\n\n                            <th class=\"sr\">\n                                Sr.\n                            </th>\n\n                            <th class=\"component\">\n                                Component\n                            </th>\n\n                            <th class=\"amount\">\n                                Amount\n                            </th>\n\n                        </tr>\n\n                    </thead>\n\n\n                    <tbody>\n\n                        {% for row in doc.deductions %}\n\n                        <tr>\n\n                            <td class=\"sr\">\n                                {{ loop.index }}\n                            </td>\n\n                            <td class=\"component\">\n                                {{ row.salary_component }}\n                            </td>\n\n                            <td class=\"amount\">\n                                {{ frappe.utils.fmt_money(\n                                    row.amount,\n                                    currency=doc.currency\n                                ) }}\n                            </td>\n\n                        </tr>\n\n                        {% endfor %}\n\n\n                        <tr class=\"total-row\">\n\n                            <td colspan=\"2\">\n                                Total Deduction\n                            </td>\n\n                            <td class=\"amount\">\n                                {{ frappe.utils.fmt_money(\n                                    doc.total_deduction | round(0),\n                                    currency=doc.currency\n                                ) }}\n                            </td>\n\n                        </tr>\n\n                    </tbody>\n\n                </table>\n\n            </div>\n\n        </div>\n\n\n        <!-- =====================================================\n             PAYMENT SUMMARY\n             ===================================================== -->\n\n        <div class=\"summary\">\n\n            <table class=\"summary-table\">\n\n                <tr>\n\n                    <td class=\"summary-label\">\n                        Gross Pay:\n                    </td>\n\n                    <td class=\"summary-amount\">\n                        {{ frappe.utils.fmt_money(\n                            doc.gross_pay | round(0),\n                            currency=doc.currency\n                        ) }}\n                    </td>\n\n                </tr>\n\n\n                <tr>\n\n                    <td class=\"summary-label\">\n                        Total Deduction:\n                    </td>\n\n                    <td class=\"summary-amount\">\n                        {{ frappe.utils.fmt_money(\n                            doc.total_deduction  | round(0),\n                            currency=doc.currency\n                        ) }}\n                    </td>\n\n                </tr>\n\n\n                <tr class=\"net-pay-row\">\n\n                    <td class=\"summary-label\">\n                        Net Pay:\n                    </td>\n\n                    <td class=\"summary-amount\">\n                        {{ frappe.utils.fmt_money(\n                            doc.net_pay | round(0),\n                            currency=doc.currency\n                        ) }}\n                    </td>\n\n                </tr>\n\n            </table>\n\n        </div>\n\n\n        <!-- =====================================================\n             AMOUNT IN WORDS\n             ===================================================== -->\n\n        <div class=\"in-words\">\n\n            <span class=\"words-label\">\n                Total In Words:\n            </span>\n\n            {{ frappe.utils.money_in_words(\n                doc.net_pay,\n                doc.currency\n            ) }}\n\n        </div>\n\n\n        <!-- =====================================================\n             FOOTER\n             ===================================================== -->\n\n        <div class=\"footer\">\n            This is a computer generated salary slip.\n        </div>\n\n\n    </div>\n\n</div>",
