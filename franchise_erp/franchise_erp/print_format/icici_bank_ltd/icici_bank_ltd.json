 "html": "<style>\r\n     \r\n    .print-format {\r\n        /*background-image: url(\"http://tejoo.localhost:8000/files/cheque1.jpeg\");*/\r\n        background-size: 20.3cm 9.3cm;\r\n        background-repeat: no-repeat;\r\n        /*height: 9.3cm;*/\r\n        /*width: 20.3cm;*/\r\n        width:203mm;\r\n        height:95mm;\r\n        padding: 0 !important;\r\n    } \r\n    \r\n\r\n    .cheque-wrapper {\r\n        position: relative;\r\n        width: 20.3cm;\r\n        height: 9.3cm;\r\n        font-family: Arial, sans-serif;\r\n        font-weight: bold;\r\n        color: #000;\r\n    }\r\n\r\n    /* 1. Account Payee Stamp */\r\n    .ac-payee {\r\n        position: absolute;\r\n        top: 2.0cm;\r\n        left: 12.6cm;\r\n        border-top: 1.2px solid #000;\r\n        border-bottom: 1.2px solid #000;\r\n        padding: 0px 5px;\r\n        font-size: 11px;\r\n    }\r\n\r\n    /* 2. Date Section - Positioned inside the date boxes */\r\n    .date-container {\r\n        position: absolute;\r\n            top: 1.35cm;\r\n    left: 19.2cm;\r\n\r\n        text-wrap: nowrap;\r\n        letter-spacing: 0.52cm; \r\n    }\r\n    .date-char {\r\n        display: inline-block;\r\n        width: 0.49cm;\r\n        text-align: center;\r\n        font-size: 15px; \r\n    }\r\n\r\n    /* 3. Payee Name - Positioned on the first line after 'Pay' */\r\n    .payee-name {\r\n        position: absolute;\r\n        top: 2.6cm;\r\n    left: 5.5cm;\r\n    font-size: 13px;\r\n    width: 18cm;\r\n    }\r\n\r\n    /* 4. Amount in Words - Positioned on the second line after 'Rupees' */\r\n    .amount-words {\r\n        position: absolute;\r\n        top: 3.4cm;\r\n        left: 6.7cm;        \r\n        width: 12.5cm;\r\n        line-height: 0.7cm;\r\n        font-size: 13px; \r\n    }\r\n\r\n    /* 5. Amount in Figures - Positioned inside the amount box */\r\n    .amount-figures {\r\n        position: absolute;\r\n                top: 4.1cm;\r\n    left: 19.4cm;\r\n    text-wrap: nowrap;\r\n\r\n        font-size: 17px; \r\n        width: 3.5cm;\r\n    }\r\n\r\n    /* 6. Account Number Box - Positioned in the dashed box on the left */\r\n    .acc-no-box {\r\n        position: absolute;\r\n        top: 4.99cm;\r\n        left: 3.6cm;\r\n        font-size: 14px;\r\n    }\r\n\r\n    /* 7. Signatory Section - Positioned above Authorised Signatories */\r\n    .signatory {\r\n        position: absolute;\r\n        top: 5.00cm; \r\n        left: 14.00cm;\r\n        width: 6.0cm;\r\n        text-align: center;\r\n        font-size: 12px;\r\n    }\r\n</style>\r\n\r\n<div class=\"cheque-wrapper\">\r\n    <!-- A/C PAYEE STAMP -->\r\n    <!--<div class=\"ac-payee\">A/C PAYEE</div>-->\r\n    \r\n    <!-- DATE SECTION (DDMMYYYY) -->\r\n    <div class=\"date-container\">\r\n        {% if doc.reference_date %}\r\n            {% set d = frappe.utils.getdate(doc.reference_date).strftime('%d%m%Y') %}\r\n            {% for char in d %}<span class=\"date-char\">{{ char }}</span>{% endfor %}\r\n        {% endif %}\r\n    </div>\r\n\r\n    <!-- PAYEE NAME -->\r\n    <!--<div class=\"payee-name\">{{ doc.party_name }}</div>-->\r\n<div class=\"payee-name\">\r\n    {% if doc.party_type == \"Customer\" %}\r\n        {{ frappe.db.get_value(\"Customer\", doc.party, \"custom_acc_name\") or doc.party_name }}\r\n    {% elif doc.party_type == \"Supplier\" %}\r\n        {{ frappe.db.get_value(\"Supplier\", doc.party, \"custom_acc_payee\") or doc.party_name }}\r\n    {% else %}\r\n        {{ doc.party_name }}\r\n    {% endif %}\r\n</div>\r\n    <!-- AMOUNT IN WORDS (Formatted to remove currency code) -->\r\n    <div class=\"amount-words\">\r\n        {{ frappe.utils.money_in_words(doc.base_paid_amount or doc.base_received_amount).replace('INR ', '').replace('Only.', 'Only') }}\r\n    </div>\r\n\r\n    <!-- AMOUNT IN FIGURES -->\r\n    <div class=\"amount-figures\">\r\n        {{ doc.get_formatted(\"base_paid_amount\").replace(\"\u20b9\", \"\").replace(\"Rs.\", \"\").replace(\".00\", \"\") or doc.get_formatted(\"base_received_amount\").replace(\"\u20b9\", \"\").replace(\"Rs.\", \"\").replace(\".00\", \"\") }} /-\r\n    </div>\r\n\r\n    <!-- ACCOUNT NUMBER -->\r\n    <!--<div class=\"acc-no-box\">{{ doc.account_no or '777705500334' }}</div>-->\r\n\r\n    <!-- COMPANY NAME FOR SIGNATURE -->\r\n    <!--<div class=\"signatory\">{{ doc.company }}</div>-->\r\n</div>",
