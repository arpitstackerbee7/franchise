  "html": "<style>\n  .gl-letterhead img { width: 100%; height: auto; display: block; }\n  .gl-title { text-align: center; margin: 6px 0 2px; font-size: 15px; font-weight: bold; }\n  .gl-sub { text-align: center; font-size: 11px; margin-bottom: 10px; }\n  .gl-table { width: 100%; border-collapse: collapse; font-size: 10px; }\n  .gl-table th, .gl-table td { border: 1px solid #999; padding: 3px 5px; }\n  .gl-table th { background: #f0f0f0; text-align: left; }\n  .gl-right { text-align: right; }\n</style>\n\n<div class=\"gl-letterhead\">\n  <img src=\"/assets/franchise_erp/images/tzu_letterhead.png\">\n</div>\n\n<div class=\"gl-title\">Party General Ledger</div>\n<div class=\"gl-sub\">\n  {% if (filters.party_type) { %}\n    {%= filters.party_type %}: {%= filters.party %} &nbsp;|&nbsp;\n  {% } %}\n  {%= frappe.datetime.str_to_user(filters.from_date) %}\n  to {%= frappe.datetime.str_to_user(filters.to_date) %}\n</div>\n\n<table class=\"gl-table\">\n  <thead>\n    <tr>\n      <th>Date</th>\n      <th>Account</th>\n      <th>Voucher Type</th>\n      <th>Voucher No</th>\n      <th class=\"gl-right\">Debit</th>\n      <th class=\"gl-right\">Credit</th>\n      <th class=\"gl-right\">Balance</th>\n    </tr>\n  </thead>\n  <tbody>\n    {% for (var i = 0, l = data.length; i < l; i++) { %}\n    <tr>\n      <td>{%= data[i].posting_date ? frappe.datetime.str_to_user(data[i].posting_date) : \"\" %}</td>\n      <td>{%= data[i].account || \"\" %}</td>\n      <td>{%= data[i].voucher_type || \"\" %}</td>\n      <td>{%= data[i].voucher_no || \"\" %}</td>\n      <td class=\"gl-right\">{%= data[i].debit ? format_currency(data[i].debit) : \"\" %}</td>\n      <td class=\"gl-right\">{%= data[i].credit ? format_currency(data[i].credit) : \"\" %}</td>\n      <td class=\"gl-right\">{%= data[i].balance != null ? format_currency(data[i].balance) : \"\" %}</td>\n    </tr>\n    {% } %}\n  </tbody>\n</table>",
